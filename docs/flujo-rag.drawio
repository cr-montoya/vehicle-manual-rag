"411.81818181818176" width="200" height="70" as="geometry"/></mxCell><mxCell id="f7" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ebfbee;strokeColor=#2f9e44;dashed=0;fontSize=12;fontColor=#1e1e1e;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="1220" height="240" as="geometry"/></mxCell><mxCell id="f8" value="1. READ&#xa;Nova Lite (parser)&#xa;page → Markdown&#xa;readable tables" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#e5dbff;strokeColor=#7048e8;dashed=0;fontSize=16;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="250" height="120" as="geometry"/></mxCell><mxCell id="f9" value="2. SPLIT&#xa;fixed rule, no AI&#xa;300 tokens&#xa;15 % overlap" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#d3f9d8;strokeColor=#2f9e44;dashed=0;fontSize=16;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="400" width="250" height="120" as="geometry"/></mxCell><mxCell id="f10" value="3. EMBED&#xa;Titan Embeddings V2&#xa;chunk → 1024 numbers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#e5dbff;strokeColor=#7048e8;dashed=0;fontSize=16;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="930" y="400" width="250" height="120" as="geometry"/></mxCell><mxCell id="f11" value="4. STORE&#xa;S3 Vectors&#xa;(lane 2: vectores.py)&#xa;vector + text + page&#xa;+ make/model/year" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#f1f3f5;strokeColor=#495057;dashed=0;fontSize=14;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="400" width="240" height="120" as="geometry"/></mxCell><mxCell id="f12" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#e8590c;dashed=1;fontSize=12;fontColor=#1e1e1e;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1540" height="400" as="geometry"/></mxCell><mxCell id="f13" value="Phone&#xa;SPA on CloudFront&#xa;(lane 6: web.py)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffe8cc;strokeColor=#e8590c;dashed=0;fontSize=14;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="180" height="90" as="geometry"/></mxCell><mxCell id="f14" value="Lambda&#xa;(lane 5: asistente.py)&#xa;backend/handler.py" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffe8cc;strokeColor=#e8590c;dashed=0;fontSize=14;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="720" width="200" height="90" as="geometry"/></mxCell><mxCell id="f15" value="Guardrail (lane 4)&#xa;in: injection, PII&#xa;out: grounding check" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffe3e3;strokeColor=#c92a2a;dashed=0;fontSize=14;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="340" y="880" width="200" height="90" as="geometry"/></mxCell><mxCell id="f16" value="a. Titan V2&#xa;question → vector" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#e5dbff;strokeColor=#7048e8;dashed=0;fontSize=16;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="720" width="250" height="90" as="geometry"/></mxCell><mxCell id="f17" value="b. S3 Vectors&#xa;FILTER by vehicle&#xa;→ 8 most similar chunks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#f1f3f5;strokeColor=#495057;dashed=0;fontSize=14;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="720" width="270" height="90" as="geometry"/></mxCell><mxCell id="f18" value="c. Nova 2 Lite&#xa;writes the answer&#xa;with citation (p. N)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#e5dbff;strokeColor=#7048e8;dashed=0;fontSize=16;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1280" y="720" width="240" height="90" as="geometry"/></mxCell><mxCell id="f19" value="Rule in code&#xa;&quot;take it to a mechanic&quot;&#xa;if safety related" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ffe3e3;strokeColor=#c92a2a;dashed=0;fontSize=14;fontColor=#1e1e1e;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1280" y="880" width="240" height="90" as="geometry"/></mxCell><mxCell id="f20" value="Vehicle manual RAG: what happens and when" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=30;fontColor=#1e1e1e;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="-70" width="838" height="41.5" as="geometry"/></mxCell><mxCell id="f21" value="Three separate moments. The PDFs are read ONCE (ingestion); each question only searches vectors." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=16;fontColor=#495057;fontStyle=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="-30" width="893" height="24" as="geometry"/></mxCell><mxCell id="f22" value="1. cdk deploy" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=22;fontColor=#1971c2;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="170" height="31.5" as="geometry"/></mxCell><mxCell id="f23" value="Uploads the artifact. Nobody reads the PDFs yet." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=14;fontColor=#495057;fontStyle=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="376" height="21.5" as="geometry"/></mxCell><mxCell id="f24" value="BucketDeployment" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#495057;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="647" y="116" width="124" height="20.25" as="geometry"/></mxCell><mxCell id="f25" value="2. ingestar.py (once per change to the manuals)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=22;fontColor=#2f9e44;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="614" height="31.5" as="geometry"/></mxCell><mxCell id="f26" value="The knowledge base orchestrates; each step is done by another component." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=14;fontColor=#495057;fontStyle=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="564" height="21.5" as="geometry"/></mxCell><mxCell id="f27" value="Knowledge base (lane 3: conocimiento.py) = the pipeline, not the store" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=17;fontColor=#2f9e44;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="717" height="25.25" as="geometry"/></mxCell><mxCell id="f28" value="triggers" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#495057;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="244" y="418" width="58" height="20.25" as="geometry"/></mxCell><mxCell id="f29" value="reads PDFs" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#495057;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="945" y="222" width="73" height="20.25" as="geometry"/></mxCell><mxCell id="f30" value="3. Each question (real time)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=22;fontColor=#e8590c;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="392" height="31.5" as="geometry"/></mxCell><mxCell id="f31" value="The PDFs are no longer touched: the search runs on the vectors." style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=14;fontColor=#495057;fontStyle=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="662" width="494" height="21.5" as="geometry"/></mxCell><mxCell id="f32" value="question + photo" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#495057;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="226" y="741" width="116" height="20.25" as="geometry"/></mxCell><mxCell id="f33" value="1st checks" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#495057;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="448" y="832" width="73" height="20.25" as="geometry"/></mxCell><mxCell id="f34" value="2nd searches" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#495057;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="545" y="741" width="87" height="20.25" as="geometry"/></mxCell><mxCell id="f35" value="same vectors as ingestion" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=13;fontColor=#495057;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1095" y="640" width="224" height="20.25" as="geometry"/></mxCell><mxCell id="f36" value="CI/CD analogy:  deploy = publish the artifact  ·  ingestion = build (read, split, embed)  ·  question = runtime" style="text;html=0;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=16;fontColor=#495057;fontStyle=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1112" height="24" as="geometry"/></mxCell><mxCell id="f37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#1e1e1e;strokeWidth=2;dashed=0;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#1e1e1e;strokeWidth=2;dashed=0;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#1e1e1e;strokeWidth=2;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.525;entryDx=0;entryDy=0;" edge="1" parent="1" source="f6" target="f7"><mxGeometry re